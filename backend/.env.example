# 複製這個檔案為 .env，再把真實值填進去。.env 已被 .gitignore 排除，絕對不要 commit。

# Neon 給你的 connection string，格式類似：
#   postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# 貼進來後，把開頭的 postgresql:// 改成 postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# 用這行指令產生：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 至少 32 字元，否則程式啟動時會直接報錯。正式環境務必與開發環境不同。
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Sprint 3 才會用到，現在留空即可
OPENAI_API_KEY=
