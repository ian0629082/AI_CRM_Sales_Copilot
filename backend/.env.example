# 複製這個檔案為 .env，再把真實值填進去。.env 已被 .gitignore 排除，絕對不要 commit。

# Neon 給你的 connection string，格式類似：
#   postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# 貼進來後，把開頭的 postgresql:// 改成 postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require

# 用這行指令產生：python -c "import secrets; print(secrets.token_urlsafe(32))"
# 至少 32 字元，否則程式啟動時會直接報錯。正式環境務必與開發環境不同。
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 允許連進來的前端網址，多個用逗號分隔。開發時就是本機的前端。
# Sprint 7 部署後要改成 Vercel 給的網址，例如：
#   CORS_ORIGINS=https://ai-crm-sales-copilot.vercel.app
# 不要填 *，那等於允許任何網站代替使用者呼叫這個 API。
CORS_ORIGINS=http://localhost:3000

# AI 需求解析用。留空的話 CRM 一切正常，只有「AI 解析」按鈕會回 503。
OPENAI_API_KEY=
# 換模型不必改程式碼。Sprint 4 可以直接跑兩個型號比較準確率與成本。
OPENAI_MODEL=gpt-5.4-mini
# 同步等待的 API 一定要設逾時，否則 OpenAI 卡住會把後端連線一起卡死。
OPENAI_TIMEOUT_SECONDS=30
