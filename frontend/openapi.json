    "/api/v1/leads/{lead_id}/analyze": {
      "post": {
        "tags": [
          "leads"
        ],
        "summary": "Analyze Lead",
        "description": "把客戶原話交給 AI 解析，結果直接寫回這位客戶的需求欄位。\n\n同步等待（約 2～5 秒），前端顯示 loading。\n做成同步是因為 MVP 階段一次只分析一筆，排背景工作要多一個 queue 與輪詢機制，\n複雜度換不到對應的好處；真的要批次分析時再改。\n\n可能的失敗：\n- 404 這位客戶不存在（或不是你的）\n- 422 這位客戶還沒填原始需求\n- 503 AI 暫時不可用 —— 客戶資料本身不受影響，前端顯示重試按鈕",
        "operationId": "analyze_lead_api_v1_leads__lead_id__analyze_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "lead_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Lead Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LeadAnalyzeResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
